<%
  var k = karyawan;
  var pilih = function (daftar) { return daftar.map(function (o) { return '<option value="' + o.id + '">' + o.label.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</option>'; }).join(''); };
  var f = fmt;
%>
<%- include('../partials/atas', { judul: k.nama }) %>
<div class="judul-halaman">
  <div class="identitas">
    <% if (k.foto_path) { %>
      <img class="foto" src="/karyawan/<%= k.id %>/foto?v=<%= new Date(k.updated_at).getTime() %>" alt="Foto <%= k.nama %>" width="64" height="64">
    <% } else { %>
      <div class="foto foto-kosong" aria-hidden="true"><%= k.nama.charAt(0).toUpperCase() %></div>
    <% } %>
    <div>
      <h1><%= k.nama %></h1>
      <span class="redup"><%= k.nomor_induk %></span>
      <span class="lencana <%= k.status === 'aktif' ? 'lencana-ok' : 'lencana-off' %>"><%= k.status %></span>
      <% if (bolehKelola) { %>
        <label class="tautan-aksi">Ganti foto
          <input type="file" accept="image/*" hidden data-unggah-foto data-url="/karyawan/<%= k.id %>/foto">
        </label>
        <span class="redup" data-pesan-foto></span>
      <% } %>
    </div>
  </div>
  <% if (bolehKelola) { %><a class="tombol tombol-sekunder" href="/karyawan/<%= k.id %>/ubah">Ubah data</a><% } %>
</div>
<% if (galat) { %><p class="galat" role="alert"><%= galat %></p><% } %>

<div x-data="{ tab: 'profil' }">
  <div class="tab-daftar" role="tablist">
    <button type="button" :class="{ 'aktif': tab === 'profil' }" @click="tab = 'profil'">Profil</button>
    <button type="button" :class="{ 'aktif': tab === 'penempatan' }" @click="tab = 'penempatan'">Penempatan</button>
    <% if (gaji) { %><button type="button" :class="{ 'aktif': tab === 'gaji' }" @click="tab = 'gaji'">Gaji</button><% } %>
    <% if (kontrak) { %><button type="button" :class="{ 'aktif': tab === 'kontrak' }" @click="tab = 'kontrak'">Kontrak</button><% } %>
    <% if (keluarga) { %><button type="button" :class="{ 'aktif': tab === 'keluarga' }" @click="tab = 'keluarga'">Keluarga</button><% } %>
    <% if (pendidikan) { %><button type="button" :class="{ 'aktif': tab === 'pendidikan' }" @click="tab = 'pendidikan'">Pendidikan</button><% } %>
    <% if (dokumen) { %><button type="button" :class="{ 'aktif': tab === 'dokumen' }" @click="tab = 'dokumen'">Dokumen</button><% } %>
    <% if (komponen) { %><button type="button" :class="{ 'aktif': tab === 'komponen' }" @click="tab = 'komponen'">Komponen gaji</button><% } %>
    <% if (kepesertaan) { %><button type="button" :class="{ 'aktif': tab === 'bpjs' }" @click="tab = 'bpjs'">BPJS</button><% } %>
    <% if (statusPajak) { %><button type="button" :class="{ 'aktif': tab === 'pajak' }" @click="tab = 'pajak'">Pajak</button><% } %>
    <% if (bolehAkun) { %><button type="button" :class="{ 'aktif': tab === 'akun' }" @click="tab = 'akun'">Akun login</button><% } %>
    <% if (bolehKelola && k.status === 'aktif') { %><button type="button" :class="{ 'aktif': tab === 'keluar' }" @click="tab = 'keluar'">Keluar</button><% } %>
  </div>

  <section class="kartu" x-show="tab === 'profil'" x-transition.opacity>
    <dl class="rincian">
      <dt>NIK</dt><dd><%= k.nik || '—' %></dd>
      <dt>NPWP</dt><dd><%= k.npwp || '—' %></dd>
      <dt>Tanggal lahir</dt><dd><%= f.tanggal(k.tanggal_lahir) || '—' %></dd>
      <dt>Jenis kelamin</dt><dd><%= k.jenis_kelamin === 'L' ? 'Laki-laki' : (k.jenis_kelamin === 'P' ? 'Perempuan' : '—') %></dd>
      <dt>Alamat</dt><dd><%= k.alamat || '—' %></dd>
      <dt>Telepon</dt><dd><%= k.telepon || '—' %></dd>
      <dt>Email</dt><dd><%= k.email || '—' %></dd>
      <dt>Bank / rekening</dt><dd><%= k.bank || '—' %> <%= k.nomor_rekening || '' %></dd>
      <dt>Tanggal masuk</dt><dd><%= f.tanggal(k.tanggal_masuk) %></dd>
      <% if (k.status === 'keluar') { %>
        <dt>Tanggal keluar</dt><dd><%= f.tanggal(k.tanggal_keluar) %></dd>
        <dt>Alasan keluar</dt><dd><%= k.alasan_keluar %></dd>
      <% } %>
    </dl>
    <% if (!sensitif) { %><p class="redup">NIK, NPWP, dan rekening disamarkan untuk peran Anda.</p><% } %>
  </section>

  <section class="kartu" x-show="tab === 'penempatan'" x-cloak x-transition.opacity>
    <div class="tabel-bungkus"><table class="tabel">
      <thead><tr><th>Berlaku sejak</th><th>Cabang</th><th>Departemen</th><th>Jabatan</th><th>Golongan</th><th>Atasan</th><% if (bolehKelola) { %><th></th><% } %></tr></thead>
      <tbody>
        <% penempatan.forEach(function (r) { %>
          <tr>
            <td><%= f.tanggal(r.tanggal_berlaku) %> <% if (r.berlaku) { %><span class="lencana lencana-ok">berlaku</span><% } %></td>
            <td><%= r.cabang %></td><td><%= r.departemen %></td><td><%= r.jabatan %></td><td><%= r.golongan || '' %></td>
            <td><%= r.atasan ? r.atasan_nomor + ' · ' + r.atasan : '' %></td>
            <% if (bolehKelola) { %><td class="aksi"><button type="button" class="tautan-bahaya" hx-post="/karyawan/<%= k.id %>/riwayat/penempatan/<%= r.id %>/hapus" hx-confirm="Hapus riwayat penempatan ini?" hx-target="closest tr" hx-swap="outerHTML swap:.2s">Hapus</button></td><% } %>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if (bolehKelola && k.status === 'aktif') { %>
    <details class="tambah"><summary>Tambah penempatan baru (mutasi / promosi)</summary>
      <form method="post" action="/karyawan/<%= k.id %>/penempatan">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Berlaku sejak *<input type="date" name="tanggal_berlaku" required></label>
        <label>Cabang *<select name="cabang_id" required><option value="">— pilih —</option><%- pilih(opsi.cabang) %></select></label>
        <label>Departemen *<select name="departemen_id" required><option value="">— pilih —</option><%- pilih(opsi.departemen) %></select></label>
        <label>Jabatan *<select name="jabatan_id" required><option value="">— pilih —</option><%- pilih(opsi.jabatan) %></select></label>
        <label>Golongan<select name="golongan_id"><option value="">— tidak ada —</option><%- pilih(opsi.golongan) %></select></label>
        <label>Atasan langsung<select name="atasan_id"><option value="">— tidak ada —</option><%- pilih(opsi.atasan) %></select></label>
        <button class="tombol" type="submit">Simpan penempatan</button>
      </form>
    </details>
    <% } %>
  </section>

  <% if (gaji) { %>
  <section class="kartu" x-show="tab === 'gaji'" x-cloak x-transition.opacity>
    <div class="tabel-bungkus"><table class="tabel">
      <thead><tr><th>Berlaku sejak</th><th>Gaji pokok</th><th>Alasan</th><th></th></tr></thead>
      <tbody>
        <% gaji.forEach(function (r) { %>
          <tr>
            <td><%= f.tanggal(r.tanggal_berlaku) %> <% if (r.berlaku) { %><span class="lencana lencana-ok">berlaku</span><% } %></td>
            <td><%= f.rupiah(r.gaji_pokok) %></td><td><%= r.alasan || '' %></td>
            <td class="aksi"><button type="button" class="tautan-bahaya" hx-post="/karyawan/<%= k.id %>/riwayat/gaji/<%= r.id %>/hapus" hx-confirm="Hapus riwayat gaji ini?" hx-target="closest tr" hx-swap="outerHTML swap:.2s">Hapus</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if (k.status === 'aktif') { %>
    <details class="tambah"><summary>Tambah perubahan gaji</summary>
      <form method="post" action="/karyawan/<%= k.id %>/gaji">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Berlaku sejak *<input type="date" name="tanggal_berlaku" required></label>
        <label>Gaji pokok (Rp) *<input type="text" name="gaji_pokok" inputmode="decimal" placeholder="5000000 atau 5000000.50" required></label>
        <label>Alasan<input type="text" name="alasan"></label>
        <button class="tombol" type="submit">Simpan gaji</button>
      </form>
    </details>
    <% } %>
  </section>
  <% } %>

  <% if (kontrak) { %>
  <section class="kartu" x-show="tab === 'kontrak'" x-cloak x-transition.opacity>
    <div class="tabel-bungkus"><table class="tabel">
      <thead><tr><th>Jenis</th><th>Mulai</th><th>Akhir</th><% if (bolehKelola) { %><th></th><% } %></tr></thead>
      <tbody>
        <% if (!kontrak.length) { %><tr><td colspan="4" class="kosong">Belum ada kontrak.</td></tr><% } %>
        <% kontrak.forEach(function (r) { %>
          <tr>
            <td><%= r.jenis %></td><td><%= f.tanggal(r.tanggal_mulai) %></td><td><%= f.tanggal(r.tanggal_akhir) || '—' %></td>
            <% if (bolehKelola) { %><td class="aksi"><button type="button" class="tautan-bahaya" hx-post="/karyawan/<%= k.id %>/riwayat/kontrak/<%= r.id %>/hapus" hx-confirm="Hapus riwayat kontrak ini?" hx-target="closest tr" hx-swap="outerHTML swap:.2s">Hapus</button></td><% } %>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if (bolehKelola && k.status === 'aktif') { %>
    <details class="tambah"><summary>Tambah kontrak baru</summary>
      <form method="post" action="/karyawan/<%= k.id %>/kontrak">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Jenis *<select name="jenis" required><option value="">— pilih —</option><option>PKWT</option><option>PKWTT</option><option>magang</option></select></label>
        <label>Tanggal mulai *<input type="date" name="tanggal_mulai" required></label>
        <label>Tanggal akhir (kosongkan untuk PKWTT)<input type="date" name="tanggal_akhir"></label>
        <button class="tombol" type="submit">Simpan kontrak</button>
      </form>
    </details>
    <% } %>
  </section>
  <% } %>

  <% if (keluarga) { %>
  <section class="kartu" x-show="tab === 'keluarga'" x-cloak x-transition.opacity>
    <div class="tabel-bungkus"><table class="tabel">
      <thead><tr><th>Nama</th><th>Hubungan</th><th>Tanggal lahir</th><th>Pekerjaan</th><th>Tanggungan</th><th>Telepon</th><% if (bolehKelola) { %><th></th><% } %></tr></thead>
      <tbody>
        <% if (!keluarga.length) { %><tr><td colspan="7" class="kosong">Belum ada data keluarga.</td></tr><% } %>
        <% keluarga.forEach(function (r) { %>
          <tr>
            <td><%= r.nama %></td><td><%= r.hubungan %></td><td><%= f.tanggal(r.tanggal_lahir) %></td>
            <td><%= r.pekerjaan || '' %></td><td><%= r.tanggungan ? 'Ya' : '' %></td><td><%= r.telepon || '' %></td>
            <% if (bolehKelola) { %><td class="aksi"><button type="button" class="tautan-bahaya" hx-post="/karyawan/<%= k.id %>/keluarga/<%= r.id %>/hapus" hx-confirm="Hapus data keluarga ini?" hx-target="closest tr" hx-swap="outerHTML swap:.2s">Hapus</button></td><% } %>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if (bolehKelola) { %>
    <details class="tambah"><summary>Tambah anggota keluarga</summary>
      <form method="post" action="/karyawan/<%= k.id %>/keluarga">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Nama *<input type="text" name="nama" required></label>
        <label>Hubungan *<select name="hubungan" required><option value="">— pilih —</option><% hubunganKeluarga.forEach(function (h) { %><option><%= h %></option><% }) %></select></label>
        <label>Tanggal lahir<input type="date" name="tanggal_lahir"></label>
        <label>Pekerjaan<input type="text" name="pekerjaan"></label>
        <label>Telepon<input type="text" name="telepon"></label>
        <label class="centang"><input type="checkbox" name="tanggungan" value="1"> Menjadi tanggungan</label>
        <button class="tombol" type="submit">Simpan</button>
      </form>
    </details>
    <% } %>
  </section>
  <% } %>

  <% if (pendidikan) { %>
  <section class="kartu" x-show="tab === 'pendidikan'" x-cloak x-transition.opacity>
    <div class="tabel-bungkus"><table class="tabel">
      <thead><tr><th>Jenjang</th><th>Institusi</th><th>Jurusan</th><th>Masuk</th><th>Lulus</th><% if (bolehKelola) { %><th></th><% } %></tr></thead>
      <tbody>
        <% if (!pendidikan.length) { %><tr><td colspan="6" class="kosong">Belum ada data pendidikan.</td></tr><% } %>
        <% pendidikan.forEach(function (r) { %>
          <tr>
            <td><%= r.jenjang %></td><td><%= r.institusi %></td><td><%= r.jurusan || '' %></td><td><%= r.tahun_masuk || '' %></td><td><%= r.tahun_lulus || '' %></td>
            <% if (bolehKelola) { %><td class="aksi"><button type="button" class="tautan-bahaya" hx-post="/karyawan/<%= k.id %>/pendidikan/<%= r.id %>/hapus" hx-confirm="Hapus data pendidikan ini?" hx-target="closest tr" hx-swap="outerHTML swap:.2s">Hapus</button></td><% } %>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if (bolehKelola) { %>
    <details class="tambah"><summary>Tambah riwayat pendidikan</summary>
      <form method="post" action="/karyawan/<%= k.id %>/pendidikan">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Jenjang *<select name="jenjang" required><option value="">— pilih —</option><% jenjangPendidikan.forEach(function (j) { %><option><%= j %></option><% }) %></select></label>
        <label>Institusi *<input type="text" name="institusi" required></label>
        <label>Jurusan<input type="text" name="jurusan"></label>
        <label>Tahun masuk<input type="number" name="tahun_masuk" min="1950" step="1"></label>
        <label>Tahun lulus<input type="number" name="tahun_lulus" min="1950" step="1"></label>
        <button class="tombol" type="submit">Simpan</button>
      </form>
    </details>
    <% } %>
  </section>
  <% } %>

  <% if (dokumen) { %>
  <section class="kartu" x-show="tab === 'dokumen'" x-cloak x-transition.opacity>
    <div class="tabel-bungkus"><table class="tabel">
      <thead><tr><th>Jenis</th><th>Nama berkas</th><th>Ukuran</th><th>Diunggah</th><th></th></tr></thead>
      <tbody>
        <% if (!dokumen.length) { %><tr><td colspan="5" class="kosong">Belum ada dokumen.</td></tr><% } %>
        <% dokumen.forEach(function (d) { %>
          <tr>
            <td><%= d.jenis %></td>
            <td><a href="/karyawan/<%= k.id %>/dokumen/<%= d.id %>" target="_blank" rel="noopener"><%= d.nama_asli %></a></td>
            <td><%= Math.ceil(d.ukuran / 1024) %> KB</td>
            <td><%= f.tanggal(new Date(d.created_at).toISOString().slice(0, 10)) %></td>
            <td class="aksi"><% if (bolehKelola) { %><button type="button" class="tautan-bahaya" hx-post="/karyawan/<%= k.id %>/dokumen/<%= d.id %>/hapus" hx-confirm="Hapus dokumen ini?" hx-target="closest tr" hx-swap="outerHTML swap:.2s">Hapus</button><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if (bolehKelola) { %>
    <details class="tambah"><summary>Unggah dokumen</summary>
      <form data-unggah-dokumen data-url="/karyawan/<%= k.id %>/dokumen">
        <label>Jenis *<select name="jenis" required><option value="">— pilih —</option><% jenisDokumen.forEach(function (j) { %><option><%= j %></option><% }) %></select></label>
        <label>Berkas * (PDF, JPG, atau PNG, maks. 2 MB)<input type="file" name="berkas" accept="application/pdf,image/jpeg,image/png" required></label>
        <p class="galat" data-pesan-dokumen hidden role="alert"></p>
        <button class="tombol" type="submit">Unggah</button>
      </form>
    </details>
    <% } %>
  </section>
  <% } %>

  <% if (komponen) { %>
  <section class="kartu" x-show="tab === 'komponen'" x-cloak x-transition.opacity>
    <p class="redup">Tunjangan dan potongan tetap per karyawan, bertanggal berlaku. Nominal diprorata menurut hari kerja. Isi 0 untuk menghentikan komponen.</p>
    <div class="tabel-bungkus"><table class="tabel">
      <thead><tr><th>Komponen</th><th>Jenis</th><th>Berlaku sejak</th><th>Nominal</th><th></th></tr></thead>
      <tbody>
        <% if (!komponen.length) { %><tr><td colspan="5" class="kosong">Belum ada komponen gaji untuk karyawan ini.</td></tr><% } %>
        <% komponen.forEach(function (r) { %>
          <tr>
            <td><%= r.nama %> <span class="redup"><%= r.kode %></span></td><td><%= r.jenis %></td>
            <td><%= f.tanggal(r.tanggal_berlaku) %> <% if (r.berlaku) { %><span class="lencana lencana-ok">berlaku</span><% } %></td>
            <td><%= f.rupiah(r.nominal) %></td>
            <td class="aksi"><button type="button" class="tautan-bahaya" hx-post="/karyawan/<%= k.id %>/komponen/<%= r.id %>/hapus" hx-confirm="Hapus riwayat komponen ini?" hx-target="closest tr" hx-swap="outerHTML swap:.2s">Hapus</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if (k.status === 'aktif') { %>
    <details class="tambah"><summary>Tambah / ubah nominal komponen</summary>
      <% if (!komponenOpsi.length) { %><p class="redup">Belum ada komponen gaji. Buat dulu di menu Komponen gaji.</p><% } else { %>
      <form method="post" action="/karyawan/<%= k.id %>/komponen">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Komponen *<select name="komponen_id" required><option value="">— pilih —</option><% komponenOpsi.forEach(function (o) { %><option value="<%= o.id %>"><%= o.nama %> (<%= o.jenis %>)</option><% }) %></select></label>
        <label>Berlaku sejak *<input type="date" name="tanggal_berlaku" required></label>
        <label>Nominal (Rp) *<input type="text" name="nominal" inputmode="decimal" placeholder="500000 atau 500000.50" required></label>
        <button class="tombol" type="submit">Simpan</button>
      </form>
      <% } %>
    </details>
    <% } %>
  </section>
  <% } %>

  <% if (kepesertaan) { %>
  <section class="kartu" x-show="tab === 'bpjs'" x-cloak x-transition.opacity>
    <p class="redup">Program BPJS yang diikuti karyawan ini. Tarif diatur di menu Pengaturan penggajian.</p>
    <form method="post" action="/karyawan/<%= k.id %>/bpjs" class="form-lebar">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% kepesertaan.forEach(function (p) { %>
        <label class="centang"><input type="checkbox" name="program" value="<%= p.program %>" <%= p.ikut ? 'checked' : '' %>> <%= p.nama %></label>
      <% }) %>
      <button class="tombol" type="submit">Simpan kepesertaan</button>
    </form>
  </section>
  <% } %>

  <% if (statusPajak) { %>
  <section class="kartu" x-show="tab === 'pajak'" x-cloak x-transition.opacity>
    <p>NPWP: <strong><%= k.npwp ? 'tercatat' : 'belum diisi' %></strong><% if (!k.npwp) { %> <span class="redup">(PPh 21 dikenai pengali tanpa NPWP sesuai parameter)</span><% } %></p>
    <h3 class="sub">Status pajak (PTKP)</h3>
    <div class="tabel-bungkus"><table class="tabel">
      <thead><tr><th>Berlaku sejak</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% if (!statusPajak.length) { %><tr><td colspan="3" class="kosong">Belum diisi. PPh 21 tidak dapat dihitung tanpa status pajak.</td></tr><% } %>
        <% statusPajak.forEach(function (r) { %>
          <tr><td><%= f.tanggal(r.tanggal_berlaku) %> <% if (r.berlaku) { %><span class="lencana lencana-ok">berlaku</span><% } %></td><td><%= r.kode_status %></td>
            <td class="aksi"><button type="button" class="tautan-bahaya" hx-post="/karyawan/<%= k.id %>/status-pajak/<%= r.id %>/hapus" hx-confirm="Hapus riwayat status pajak ini?" hx-target="closest tr" hx-swap="outerHTML swap:.2s">Hapus</button></td></tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if (k.status === 'aktif') { %>
    <details class="tambah"><summary>Tambah / ubah status pajak</summary>
      <% if (!statusTersedia.length) { %><p class="redup">Tabel PTKP belum diimpor. Isi di menu Pajak (PPh 21).</p><% } else { %>
      <form method="post" action="/karyawan/<%= k.id %>/status-pajak">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Status *<select name="kode_status" required><option value="">— pilih —</option><% statusTersedia.forEach(function (s) { %><option><%= s.kode %></option><% }) %></select></label>
        <label>Berlaku sejak *<input type="date" name="tanggal_berlaku" required></label>
        <button class="tombol" type="submit">Simpan</button>
      </form>
      <% } %>
    </details>
    <% } %>

    <h3 class="sub">Saldo awal pajak</h3>
    <p class="redup">Hanya perlu bila PPh 21 mulai dihitung di tengah tahun: penghasilan bruto, iuran pengurang, dan PPh 21 yang sudah dipotong dari Januari sampai bulan sebelum sistem ini menghitung.</p>
    <div class="tabel-bungkus"><table class="tabel">
      <thead><tr><th>Tahun</th><th>Sampai bulan</th><th>Bruto</th><th>Iuran pengurang</th><th>PPh 21 dipotong</th></tr></thead>
      <tbody>
        <% if (!saldoAwalPajak.length) { %><tr><td colspan="5" class="kosong">Tidak ada.</td></tr><% } %>
        <% saldoAwalPajak.forEach(function (s) { %>
          <tr><td><%= s.tahun %></td><td><%= s.sampai_bulan %></td><td><%= f.rupiah(s.bruto_ytd) %></td><td><%= f.rupiah(s.iuran_pengurang_ytd) %></td><td><%= f.rupiah(s.pph21_ytd) %></td></tr>
        <% }) %>
      </tbody>
    </table></div>
    <details class="tambah"><summary>Isi / ganti saldo awal pajak</summary>
      <form method="post" action="/karyawan/<%= k.id %>/saldo-awal-pajak">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Tahun *<input type="number" name="tahun" min="2000" max="2100" step="1" required></label>
        <label>Sampai bulan ke- (1-11) *<input type="number" name="sampai_bulan" min="1" max="11" step="1" required></label>
        <label>Penghasilan bruto (Rp) *<input type="text" name="bruto_ytd" inputmode="decimal" placeholder="0" required></label>
        <label>Iuran pengurang (Rp) *<input type="text" name="iuran_pengurang_ytd" inputmode="decimal" placeholder="0" required></label>
        <label>PPh 21 yang sudah dipotong (Rp) *<input type="text" name="pph21_ytd" inputmode="decimal" placeholder="0" required></label>
        <button class="tombol" type="submit">Simpan</button>
      </form>
    </details>
  </section>
  <% } %>

  <% if (bolehAkun) { %>
  <section class="kartu" x-show="tab === 'akun'" x-cloak x-transition.opacity>
    <% if (akun) { %>
      <dl class="rincian">
        <dt>Username</dt><dd><%= akun.username %></dd>
        <dt>Peran</dt><dd><%= akun.peran %></dd>
        <dt>Status</dt><dd><%= akun.aktif ? 'Aktif' : 'Dicabut' %></dd>
      </dl>
    <% } else if (k.status === 'aktif') { %>
      <form method="post" action="/karyawan/<%= k.id %>/akun" class="form-lebar">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Username *<input type="text" name="username" autocomplete="off" required></label>
        <label>Password sementara * (min. 8 karakter)<input type="password" name="password" autocomplete="new-password" required></label>
        <label>Peran *
          <select name="peran" required>
            <% peranAkun.forEach(function (p) { %><option value="<%= p %>"><%= p %></option><% }) %>
          </select>
        </label>
        <button class="tombol" type="submit">Buat akun</button>
      </form>
    <% } else { %><p class="redup">Karyawan sudah keluar; tidak ada akun aktif.</p><% } %>
  </section>
  <% } %>

  <% if (bolehKelola && k.status === 'aktif') { %>
  <section class="kartu" x-show="tab === 'keluar'" x-cloak x-transition.opacity>
    <p>Karyawan tidak dihapus. Statusnya menjadi <strong>keluar</strong>, login dicabut, dan seluruh riwayat tetap tersimpan.</p>
    <form method="post" action="/karyawan/<%= k.id %>/keluar" class="form-lebar">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Tanggal keluar *<input type="date" name="tanggal_keluar" required></label>
      <label>Alasan keluar *<textarea name="alasan_keluar" rows="2" required></textarea></label>
      <button class="tombol tombol-bahaya" type="submit" @click="if (!confirm('Tandai karyawan ini sebagai keluar dan cabut login?')) $event.preventDefault()">Proses karyawan keluar</button>
    </form>
  </section>
  <% } %>
</div>
<script src="/js/gambar.js" defer></script>
<script src="/js/unggah.js" defer></script>
<%- include('../partials/bawah') %>
