<%- include('../partials/atas', { judul: 'Slip gaji ' + judulPeriode }) %>
<div class="judul-halaman">
  <div>
    <h1>Slip gaji <%= judulPeriode %></h1>
    <span class="redup"><%= slip.nama %> · <%= slip.nomor_induk %></span>
    <% if (!sudahDikunci) { %><span class="lencana lencana-tunggu">belum dikunci</span><% } %>
  </div>
  <a class="tombol" href="/penggajian/slip/<%= slip.id %>/pdf" target="_blank" rel="noopener">Unduh PDF</a>
</div>

<section class="kartu blok">
  <dl class="rincian">
    <dt>Jabatan</dt><dd><%= slip.jabatan || '—' %></dd>
    <dt>Departemen</dt><dd><%= slip.departemen || '—' %></dd>
    <dt>Periode</dt><dd><%= fmt.tanggal(slip.tanggal_awal) %> s.d. <%= fmt.tanggal(slip.tanggal_akhir) %></dd>
    <dt>Hari kerja</dt><dd><%= slip.hari_kerja_bekerja %> dari <%= slip.hari_kerja_periode %> hari</dd>
    <% if (slip.menit_terlambat) { %><dt>Keterlambatan</dt><dd><%= slip.menit_terlambat %> menit</dd><% } %>
  </dl>
</section>

<% [['Pendapatan', pendapatan], ['Potongan', potongan]].forEach(function (g) { %>
<section class="kartu blok">
  <h2><%= g[0] %></h2>
  <div class="tabel-bungkus"><table class="tabel"><tbody>
    <% if (!g[1].length) { %><tr><td class="kosong">Tidak ada.</td></tr><% } %>
    <% g[1].forEach(function (r) { %>
      <tr><td><%= r.nama %><% if (r.keterangan) { %><br><span class="redup"><%= r.keterangan %></span><% } %></td><td class="aksi"><%= fmt.rupiah(r.nominal) %></td></tr>
    <% }) %>
  </tbody></table></div>
</section>
<% }) %>

<section class="kartu blok">
  <dl class="rincian">
    <dt>Total pendapatan</dt><dd><%= fmt.rupiah(slip.gaji_bruto) %></dd>
    <dt>Total potongan</dt><dd><%= fmt.rupiah(slip.total_potongan) %></dd>
    <dt><strong>Gaji bersih</strong></dt><dd><strong><%= fmt.rupiah(slip.gaji_bersih) %></strong></dd>
  </dl>
  <% if (!slip.metode_pajak) { %><p class="redup">Gaji bersih belum memperhitungkan PPh 21.</p><% } %>
</section>

<% if (beban.length) { %>
<section class="kartu blok">
  <h2>Iuran ditanggung perusahaan</h2>
  <p class="redup">Informasi; tidak mengurangi gaji Anda.</p>
  <div class="tabel-bungkus"><table class="tabel"><tbody>
    <% beban.forEach(function (r) { %><tr><td><%= r.nama %></td><td class="aksi"><%= fmt.rupiah(r.nominal) %></td></tr><% }) %>
  </tbody></table></div>
</section>
<% } %>
<%- include('../partials/bawah') %>
