<%- include('../partials/atas', { judul: 'Beranda' }) %>
<section class="sapaan">
  <h1><%= sapaan %>, <%= nama %></h1>
  <p><%= peran %> · <%= fmt.hari(tanggal) %>, <%= fmt.tanggal(tanggal) %></p>
</section>

<% if (kartu.length) { %>
<section class="statistik" aria-label="Ringkasan">
  <% kartu.forEach(function (k) { %>
    <a class="kartu-stat <%= k.nada ? 'nada-' + k.nada : '' %>" href="<%= k.href %>">
      <span class="stat-ikon"><%- ikon(k.ikon, 22) %></span>
      <span class="stat-label"><%= k.label %></span>
      <span class="stat-nilai"><%= k.nilai %></span>
      <span class="stat-ket"><%= k.ket %></span>
    </a>
  <% }) %>
</section>
<% } %>

<% if (grupMenu.length) { %>
<section class="semua-menu" aria-labelledby="judul-semua-menu">
  <h2 id="judul-semua-menu" class="judul-bagian">Semua menu</h2>
  <div class="grup-ubin">
    <ul class="ubin-daftar">
      <% grupMenu.forEach(function (g) { g.item.forEach(function (m) { %>
        <li class="grup-<%= g.slug %>">
          <a class="ubin" href="<%= m.href %>" title="<%= g.nama %>">
            <span class="ubin-ikon"><%- ikon(m.ikon, 28) %></span>
            <span class="ubin-label"><%= m.label %></span>
          </a>
        </li>
      <% }) }) %>
    </ul>
  </div>
</section>
<% } %>
<%- include('../partials/bawah') %>
