<%- include('../partials/atas', { judul: 'Beranda' }) %>
<section class="sorotan">
  <div>
    <h1><%= sapaan %>, <%= nama %></h1>
    <ul class="sorotan-info">
      <li><%- ikon('profil', 16) %><%= peran %><%= modeKaryawan ? ' · Mode Karyawan' : '' %></li>
      <li><%- ikon('kalender', 16) %><%= fmt.hari(tanggal) %>, <%= fmt.tanggal(tanggal) %></li>
    </ul>
  </div>
  <% if (aksiUtama) { %><a class="tombol" href="<%= aksiUtama.href %>"><%- ikon(aksiUtama.ikon, 20) %> <%= aksiUtama.label %></a><% } %>
</section>

<% if (kartu.length) { %>
<section class="statistik" aria-label="Ringkasan">
  <% kartu.forEach(function (k) { %>
    <a class="kartu-stat <%= k.nada ? 'nada-' + k.nada : '' %>" href="<%= k.href %>">
      <span class="stat-ikon"><%- ikon(k.ikon, 22) %></span>
      <span class="stat-label"><%= k.label %></span>
      <span class="stat-nilai"><%= k.nilai %></span>
      <span class="stat-ket"><%= k.ket %></span>
    </a>
  <% }) %>
</section>
<% } %>

<% if (grupMenu.length) { %>
<section class="semua-menu" aria-labelledby="judul-semua-menu">
  <h2 id="judul-semua-menu" class="judul-bagian">Semua menu</h2>
  <div class="menu-kisi">
    <% grupMenu.forEach(function (g) { %>
      <div class="grup-ubin grup-<%= g.slug %>">
        <h3 class="grup-ubin-judul"><span class="nav-ikon"><%- ikon(g.ikon, 18) %></span><%= g.nama %><span class="jumlah"><%= g.item.length %></span></h3>
        <ul class="ubin-daftar">
          <% g.item.forEach(function (m) { %>
            <li>
              <a class="ubin" href="<%= m.href %>">
                <span class="ubin-ikon"><%- ikon(m.ikon, 24) %></span>
                <span class="ubin-label"><%= m.label %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    <% }) %>
  </div>
</section>
<% } %>
<%- include('../partials/bawah') %>
