<%- include('../partials/atas', { judul: 'Absen saya' }) %>
<div class="judul-halaman"><h1>Absen saya</h1></div>
<% if (!terhubung) { %>
  <div class="kartu"><p>Akun Anda belum terhubung ke data karyawan, sehingga tidak dapat absen. Hubungi administrator.</p></div>
<% } else { %>
  <section class="kartu blok tap">
    <div class="tap-kepala">
      <div>
        <h2><%= fmt.hari(status.tanggal) %>, <%= fmt.tanggal(status.tanggal) %></h2>
        <p class="redup">Waktu dicatat dari jam server (<%= status.zona %>), bukan jam perangkat Anda.</p>
      </div>
      <p class="tap-jam" data-jam data-zona="<%= status.zona %>" aria-label="Jam saat ini" aria-live="off">--:--:--</p>
    </div>

    <% if (!status.adaPenempatan) { %>
      <p class="galat">Penempatan cabang Anda belum diatur, sehingga belum bisa absen. Hubungi HR.</p>
    <% } else { %>
    <div data-absen data-url-masuk="/absensi/masuk" data-url-pulang="/absensi/pulang" class="tap-isi">
      <div class="kamera" data-kamera>
        <video data-video playsinline muted autoplay></video>
        <div class="kamera-panduan" aria-hidden="true"></div>
        <div class="kamera-lapis" data-lapis>
          <span class="kamera-ikon"><%- ikon('kamera', 34) %></span>
          <span data-kamera-teks>Menyalakan kamera…</span>
          <button type="button" class="tombol tombol-sekunder" data-nyalakan hidden>Nyalakan kamera</button>
        </div>
        <div class="kamera-kilat" data-kilat aria-hidden="true"></div>
      </div>

      <div class="tap-panel">
        <div class="tap-status">
          <div class="tap-kotak <%= status.masuk ? 'selesai' : '' %>">
            <span class="tap-kotak-ikon"><%- ikon('tapin', 22) %></span>
            <span class="tap-kotak-label">Tap In</span>
            <strong><%= status.masuk ? status.masuk.jam : 'Belum' %></strong>
          </div>
          <div class="tap-kotak <%= status.pulang ? 'selesai' : '' %>">
            <span class="tap-kotak-ikon"><%- ikon('tapout', 22) %></span>
            <span class="tap-kotak-label">Tap Out</span>
            <strong><%= status.pulang ? status.pulang.jam : 'Belum' %></strong>
          </div>
        </div>

        <div class="tap-aksi">
          <button class="tombol tap-tombol" type="button" data-aksi="masuk" <%= status.masuk ? 'disabled' : '' %>><%- ikon('tapin', 22) %> Tap In</button>
          <button class="tombol tap-tombol tap-keluar" type="button" data-aksi="pulang" <%= (!status.masuk || status.pulang) ? 'disabled' : '' %>><%- ikon('tapout', 22) %> Tap Out</button>
        </div>

        <ul class="tap-syarat">
          <li><%- ikon('kamera', 18) %><span>Arahkan wajah ke dalam bingkai, lalu tekan Tap In atau Tap Out. Foto diambil langsung dari kamera.</span></li>
          <li><%- ikon('lokasi', 18) %><span data-lokasi-teks>Lokasi dicatat bila Anda mengizinkan.</span></li>
        </ul>
        <p class="redup" data-pesan role="status" aria-live="polite"></p>
        <input type="file" accept="image/*" capture="user" hidden data-foto>
      </div>
    </div>
    <% } %>
  </section>
  <%- include('riwayat_tabel') %>
<% } %>
<script src="/js/gambar.js" defer></script>
<script src="/js/absen.js" defer></script>
<%- include('../partials/bawah') %>
